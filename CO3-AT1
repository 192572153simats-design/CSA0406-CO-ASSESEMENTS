question 4:Translation Lookaside Buffer (TLB)

#include <stdio.h>
int main() {
    float mat, tlb, hit, emat;
    printf("Enter Memory Access Time: ");
    scanf("%f",&mat);
    printf("Enter TLB Access Time: ");
    scanf("%f",&tlb);
    printf("Enter Hit Ratio: ");
    scanf("%f",&hit);
    emat = hit * (tlb + mat) +(1 - hit) * (tlb + 2 * mat);
    printf("Effective Memory Access Time = %.2f\n", emat);
    return 0;
}
output:
Enter Memory Access Time: 100
Enter TLB Access Time: 20
Enter Hit Ratio: 0.8
Effective Memory Access Time = 140.00

question5:Memory Protection Using Base and Limit Registers

#include <stdio.h>
int main() {
    int base, limit, logical;

    printf("Enter Base Register: ");
    scanf("%d",&base);

    printf("Enter Limit Register: ");
    scanf("%d",&limit);

    printf("Enter Logical Address: ");
    scanf("%d",&logical);

    if(logical < limit)
        printf("Access Allowed\n");
    else
        printf("Access Denied\n");

    return 0;
}

